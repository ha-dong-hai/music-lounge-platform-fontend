# Địa chỉ máy chủ API. Không đặt thì dùng máy chủ đang chạy trên Azure (xem src/config/axios.js).
# Đổi sang máy chủ khác thì nhớ nhờ backend thêm origin của FE vào Cors__AllowedOrigins, nếu không
# trình duyệt sẽ chặn mọi lời gọi.
VITE_API_BASE_URL=

# Firebase Web SDK config cho đăng nhập Google — lấy tại:
# Firebase Console > dự án "sign-in-52d07" > Project settings > Your apps > Web app > SDK setup and configuration
# Đây là config public (không phải secret), an toàn để commit dạng .env.example, nhưng file .env.local
# thật (chứa giá trị thật) không nên commit — đã có trong .gitignore theo mặc định của Vite.
# Không set các biến này thì nút "Đăng nhập với Google" vẫn hiển thị nhưng sẽ báo lỗi rõ ràng
# thay vì crash — luồng email/password không phụ thuộc vào các biến này.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=sign-in-52d07
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
