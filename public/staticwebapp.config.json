{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/models/*", "/*.{css,js,mjs,svg,png,jpg,jpeg,webp,gif,ico,json,glb,gltf,bin,woff,woff2,txt,map}"]
  },
  "mimeTypes": {
    ".glb": "model/gltf-binary",
    ".gltf": "model/gltf+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
